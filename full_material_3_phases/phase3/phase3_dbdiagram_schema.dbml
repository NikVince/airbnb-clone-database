// Airbnb Database Schema - Phase 3 Final Implementation
// 27 entities with 3 TRUE triple relationships and 1 recursive relationship
// Enhanced with comprehensive constraints, indexes, and business logic
// Updated based on Phase 3 implementation with complete data integrity

// ==============================================
// USER MANAGEMENT DOMAIN (ENHANCED WITH CONSTRAINTS)
// ==============================================

Table users {
  user_id int [pk, increment]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  phone varchar(20) [unique, not null]
  date_of_birth date
  // ROLE TRACKING FLAGS (ENHANCED)
  is_guest boolean [default: true]
  is_host boolean [default: false]
  is_admin boolean [default: false]
  created_at datetime [not null]
  updated_at datetime [not null]
  is_active boolean [default: true]
  
  // PHASE 3 CONSTRAINTS
  indexes {
    email [name: "idx_users_email"]
    phone [name: "idx_users_phone"]
    is_active [name: "idx_users_active"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_users_email CHECK (email REGEXP '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$')
  CONSTRAINT chk_users_phone CHECK (phone REGEXP '^\\+[1-9]\\d{1,14}$')
  CONSTRAINT chk_users_role_consistency CHECK (
    (is_guest = TRUE AND is_host = FALSE AND is_admin = FALSE) OR
    (is_guest = TRUE AND is_host = TRUE AND is_admin = FALSE) OR
    (is_guest = FALSE AND is_host = FALSE AND is_admin = TRUE)
  )
  '''
}

// Guest-specific attributes and preferences (ENHANCED)
Table guest_profiles {
  guest_profile_id int [pk, increment]
  user_id int [not null, unique] // 1:1 relationship with users
  preferred_price_range varchar(50)
  preferred_property_types json
  travel_preferences json
  guest_verification_status varchar(20) [default: 'unverified'] // 'unverified', 'email_verified', 'phone_verified', 'id_verified', 'fully_verified'
  verification_date datetime
  created_at datetime [not null]
  
  // PHASE 3 CONSTRAINTS
  indexes {
    user_id [name: "idx_guest_profiles_user_id"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_guest_verification_status CHECK (guest_verification_status IN ('unverified', 'email_verified', 'phone_verified', 'id_verified', 'fully_verified'))
  '''
}

// Host-specific attributes and performance metrics (ENHANCED)
Table host_profiles {
  host_profile_id int [pk, increment]
  user_id int [not null, unique] // 1:1 relationship with users
  host_verification_status varchar(20) [default: 'pending'] // 'pending', 'verified', 'rejected', 'suspended'
  verification_date datetime
  host_since datetime
  response_rate decimal(5,2) [default: 0.00]
  response_time_hours int
  acceptance_rate decimal(5,2) [default: 0.00]
  host_rating decimal(3,2)
  total_properties int [default: 0]
  superhost_status boolean [default: false]
  payout_method_id int // FK to payment_methods
  tax_id varchar(50) // ENCRYPTED
  business_name varchar(255)
  business_registration varchar(100)
  created_at datetime [not null]
  
  // PHASE 3 CONSTRAINTS
  indexes {
    user_id [name: "idx_host_profiles_user_id"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_host_verification_status CHECK (host_verification_status IN ('pending', 'verified', 'rejected', 'suspended'))
  CONSTRAINT chk_host_response_rate CHECK (response_rate >= 0 AND response_rate <= 100)
  CONSTRAINT chk_host_acceptance_rate CHECK (acceptance_rate >= 0 AND acceptance_rate <= 100)
  CONSTRAINT chk_host_rating CHECK (host_rating >= 1 AND host_rating <= 5)
  CONSTRAINT chk_host_total_properties CHECK (total_properties >= 0)
  '''
}

Table user_profiles {
  profile_id int [pk, increment]
  user_id int [not null]
  bio text
  profile_picture varchar(500)
  language_preference varchar(10) [default: 'en']
  currency_preference varchar(3) [default: 'USD']
  timezone varchar(50)
  notification_settings json
  
  // PHASE 3 CONSTRAINTS
  // Business Rules
  note: '''
  CONSTRAINT chk_user_profiles_language CHECK (language_preference IN ('en', 'es', 'fr', 'de', 'it', 'pt', 'ru', 'zh', 'ja', 'ko'))
  CONSTRAINT chk_user_profiles_currency CHECK (currency_preference IN ('USD', 'EUR', 'GBP', 'CAD', 'AUD', 'JPY', 'CHF', 'CNY'))
  '''
}

Table user_verification {
  verification_id int [pk, increment]
  user_id int [not null]
  verification_type varchar(50) [not null]
  document_type varchar(50) [not null]
  document_number varchar(100) [not null]
  verification_status varchar(20) [not null]
  verified_at datetime
  expires_at datetime
  
  // PHASE 3 CONSTRAINTS
  // Business Rules
  note: '''
  CONSTRAINT chk_verification_type CHECK (verification_type IN ('email', 'phone', 'identity', 'payment', 'address'))
  CONSTRAINT chk_document_type CHECK (document_type IN ('passport', 'drivers_license', 'national_id', 'utility_bill', 'bank_statement'))
  CONSTRAINT chk_verification_status CHECK (verification_status IN ('pending', 'verified', 'rejected', 'expired'))
  '''
}

Table user_preferences {
  preference_id int [pk, increment]
  user_id int [not null]
  preference_key varchar(100) [not null]
  preference_value json [not null]
  updated_at datetime [not null]
}

// ==============================================
// LOCATION DOMAIN (ENHANCED WITH CONSTRAINTS)
// ==============================================

Table countries {
  country_id int [pk, increment]
  country_name varchar(100) [not null, unique]
  country_code varchar(3) [not null, unique]
  currency_code varchar(3) [not null]
  phone_code varchar(5)
  
  // PHASE 3 CONSTRAINTS
  // Business Rules
  note: '''
  CONSTRAINT chk_country_code CHECK (LENGTH(country_code) = 3)
  CONSTRAINT chk_currency_code CHECK (LENGTH(currency_code) = 3)
  '''
}

Table cities {
  city_id int [pk, increment]
  city_name varchar(100) [not null]
  state_province varchar(100)
  country_id int [not null]
  timezone varchar(50)
  population int
  
  // PHASE 3 CONSTRAINTS
  // Business Rules
  note: '''
  CONSTRAINT chk_cities_population CHECK (population >= 0)
  '''
}

Table addresses {
  address_id int [pk, increment]
  street_address varchar(200) [not null]
  city_id int [not null]
  postal_code varchar(20)
  latitude decimal(10,8) [not null]
  longitude decimal(11,8) [not null]
  country_id int [not null]
  
  // PHASE 3 CONSTRAINTS
  indexes {
    city_id [name: "idx_addresses_city_id"]
    country_id [name: "idx_addresses_country_id"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_addresses_latitude CHECK (latitude >= -90 AND latitude <= 90)
  CONSTRAINT chk_addresses_longitude CHECK (longitude >= -180 AND longitude <= 180)
  '''
}

// ==============================================
// PROPERTY MANAGEMENT DOMAIN (ENHANCED WITH CONSTRAINTS)
// ==============================================

Table property_types {
  property_type_id int [pk, increment]
  type_name varchar(50) [not null, unique]
  description text
  icon_url varchar(500)
  
  // PHASE 3 CONSTRAINTS
  // Business Rules
  note: '''
  CONSTRAINT chk_property_types_icon_url CHECK (icon_url REGEXP '^https?://[^\\s]+$' OR icon_url IS NULL)
  '''
}

Table property_amenities {
  amenity_id int [pk, increment]
  amenity_name varchar(100) [not null, unique]
  amenity_category varchar(50) [not null]
  icon_url varchar(500)
  description text
  
  // PHASE 3 CONSTRAINTS
  // Business Rules
  note: '''
  CONSTRAINT chk_amenities_icon_url CHECK (icon_url REGEXP '^https?://[^\\s]+$' OR icon_url IS NULL)
  '''
}

Table properties {
  property_id int [pk, increment]
  host_id int [not null] // UPDATED: Now references host_profiles.host_profile_id
  property_type_id int [not null]
  title varchar(200) [not null]
  description text
  address_id int [not null]
  max_guests int [not null]
  bedrooms int [not null]
  bathrooms decimal(3,1) [not null]
  size_sqm decimal(8,2)
  created_at datetime [not null]
  updated_at datetime [not null]
  is_active boolean [default: true]
  
  // PHASE 3 CONSTRAINTS
  indexes {
    host_id [name: "idx_properties_host_id"]
    property_type_id [name: "idx_properties_type_id"]
    address_id [name: "idx_properties_address_id"]
    is_active [name: "idx_properties_active"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_properties_max_guests CHECK (max_guests > 0)
  CONSTRAINT chk_properties_bedrooms CHECK (bedrooms >= 0)
  CONSTRAINT chk_properties_bathrooms CHECK (bathrooms >= 0)
  CONSTRAINT chk_properties_size_sqm CHECK (size_sqm > 0 OR size_sqm IS NULL)
  '''
}

Table property_amenity_links {
  link_id int [pk, increment]
  property_id int [not null]
  amenity_id int [not null]
  is_available boolean [default: true]
  additional_info text
  
  // PHASE 3 CONSTRAINTS
  indexes {
    property_id [name: "idx_property_amenity_links_property_id"]
    amenity_id [name: "idx_property_amenity_links_amenity_id"]
  }
  
  // Business Rules
  note: '''
  UNIQUE KEY uk_property_amenity_links_unique (property_id, amenity_id)
  '''
}

Table property_photos {
  photo_id int [pk, increment]
  property_id int [not null]
  photo_url varchar(500) [not null]
  caption varchar(200)
  is_primary boolean [default: false]
  display_order int [default: 0]
  uploaded_at datetime [not null]
  
  // PHASE 3 CONSTRAINTS
  indexes {
    property_id [name: "idx_property_photos_property_id"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_property_photos_url CHECK (photo_url REGEXP '^https?://[^\\s]+$')
  CONSTRAINT chk_property_photos_display_order CHECK (display_order >= 0)
  '''
}

Table property_pricing {
  pricing_id int [pk, increment]
  property_id int [not null]
  start_date date [not null]
  end_date date [not null]
  base_price_per_night decimal(10,2) [not null]
  weekend_price_per_night decimal(10,2)
  weekly_discount_percentage decimal(5,2) [default: 0]
  monthly_discount_percentage decimal(5,2) [default: 0]
  minimum_stay_nights int [default: 1]
  maximum_stay_nights int
  is_available boolean [default: true]
  created_at datetime [not null]
  updated_at datetime [not null]
  
  // PHASE 3 CONSTRAINTS
  indexes {
    property_id [name: "idx_property_pricing_property_id"]
    (start_date, end_date) [name: "idx_property_pricing_dates"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_pricing_dates CHECK (end_date > start_date)
  CONSTRAINT chk_pricing_base_price CHECK (base_price_per_night > 0)
  CONSTRAINT chk_pricing_weekend_price CHECK (weekend_price_per_night > 0 OR weekend_price_per_night IS NULL)
  CONSTRAINT chk_pricing_weekly_discount CHECK (weekly_discount_percentage >= 0 AND weekly_discount_percentage <= 100)
  CONSTRAINT chk_pricing_monthly_discount CHECK (monthly_discount_percentage >= 0 AND monthly_discount_percentage <= 100)
  CONSTRAINT chk_pricing_minimum_stay CHECK (minimum_stay_nights > 0)
  CONSTRAINT chk_pricing_maximum_stay CHECK (maximum_stay_nights > 0 OR maximum_stay_nights IS NULL)
  '''
}

// ==============================================
// BOOKING SYSTEM DOMAIN (ENHANCED WITH CONSTRAINTS)
// ==============================================

Table booking_status {
  status_id int [pk, increment]
  status_name varchar(50) [not null, unique]
  description text
  is_active boolean [default: true]
}

Table bookings {
  booking_id int [pk, increment]
  guest_profile_id int [not null] // UPDATED: Now references guest_profiles.guest_profile_id
  user_id int [not null] // KEPT: For audit trail and authentication
  property_id int [not null]
  booking_status_id int [not null]
  check_in_date date [not null]
  check_out_date date [not null]
  number_of_guests int [not null]
  total_amount decimal(10,2) [not null]
  created_at datetime [not null]
  confirmed_at datetime
  
  // PHASE 3 CONSTRAINTS
  indexes {
    guest_profile_id [name: "idx_bookings_guest_profile_id"]
    user_id [name: "idx_bookings_user_id"]
    property_id [name: "idx_bookings_property_id"]
    booking_status_id [name: "idx_bookings_status_id"]
    (check_in_date, check_out_date) [name: "idx_bookings_dates"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_bookings_dates CHECK (check_out_date > check_in_date)
  CONSTRAINT chk_bookings_guests CHECK (number_of_guests > 0)
  CONSTRAINT chk_bookings_amount CHECK (total_amount > 0)
  '''
}

Table booking_modifications {
  modification_id int [pk, increment]
  booking_id int [not null]
  modification_type varchar(50) [not null]
  old_value text
  new_value text
  reason text
  created_at datetime [not null]
  approved_by int
  
  // PHASE 3 CONSTRAINTS
  indexes {
    booking_id [name: "idx_booking_modifications_booking_id"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_modification_type CHECK (modification_type IN ('date_change', 'guest_count_change', 'cancellation', 'refund', 'price_adjustment'))
  '''
}

// ==============================================
// FINANCIAL DOMAIN (ENHANCED WITH CONSTRAINTS)
// ==============================================

Table payment_methods {
  payment_method_id int [pk, increment]
  user_id int [not null]
  method_type varchar(50) [not null]
  card_last_four varchar(4)
  expiry_date varchar(7)
  is_default boolean [default: false]
  is_active boolean [default: true]
  
  // PHASE 3 CONSTRAINTS
  // Business Rules
  note: '''
  CONSTRAINT chk_payment_method_type CHECK (method_type IN ('credit_card', 'debit_card', 'paypal', 'bank_transfer', 'apple_pay', 'google_pay'))
  CONSTRAINT chk_card_last_four CHECK (card_last_four REGEXP '^[0-9]{4}$' OR card_last_four IS NULL)
  CONSTRAINT chk_expiry_date CHECK (expiry_date REGEXP '^[0-9]{2}/[0-9]{4}$' OR expiry_date IS NULL)
  '''
}

Table payments {
  payment_id int [pk, increment]
  booking_id int [not null]
  payment_method_id int [not null]
  amount decimal(10,2) [not null]
  currency varchar(3) [not null]
  payment_status varchar(20) [not null]
  transaction_id varchar(100) [unique]
  processed_at datetime
  refunded_at datetime
  
  // PHASE 3 CONSTRAINTS
  indexes {
    booking_id [name: "idx_payments_booking_id"]
    payment_method_id [name: "idx_payments_method_id"]
    payment_status [name: "idx_payments_status"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_payments_amount CHECK (amount > 0)
  CONSTRAINT chk_payments_currency CHECK (LENGTH(currency) = 3)
  CONSTRAINT chk_payments_status CHECK (payment_status IN ('pending', 'processing', 'completed', 'failed', 'refunded', 'cancelled'))
  '''
}

Table payouts {
  payout_id int [pk, increment]
  host_profile_id int [not null] // UPDATED: Now references host_profiles.host_profile_id
  booking_id int [not null]
  amount decimal(10,2) [not null]
  currency varchar(3) [not null]
  payout_status varchar(20) [not null]
  scheduled_date datetime
  processed_date datetime
  
  // PHASE 3 CONSTRAINTS
  indexes {
    host_profile_id [name: "idx_payouts_host_profile_id"]
    booking_id [name: "idx_payouts_booking_id"]
    payout_status [name: "idx_payouts_status"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_payouts_amount CHECK (amount > 0)
  CONSTRAINT chk_payouts_currency CHECK (LENGTH(currency) = 3)
  CONSTRAINT chk_payouts_status CHECK (payout_status IN ('pending', 'processing', 'completed', 'failed', 'cancelled'))
  '''
}

// ==============================================
// REVIEW SYSTEM DOMAIN (ENHANCED WITH CONSTRAINTS)
// ==============================================

Table review_categories {
  category_id int [pk, increment]
  category_name varchar(50) [not null, unique]
  description text
  weight decimal(3,2) [default: 1.00]
}

Table reviews {
  review_id int [pk, increment]
  reviewer_id int [not null]
  reviewee_id int [not null]
  booking_id int [not null]
  rating int [not null]
  review_text text
  is_public boolean [default: true]
  created_at datetime [not null]
  updated_at datetime [not null]
  
  // PHASE 3 CONSTRAINTS
  indexes {
    reviewer_id [name: "idx_reviews_reviewer_id"]
    reviewee_id [name: "idx_reviews_reviewee_id"]
    booking_id [name: "idx_reviews_booking_id"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_reviews_rating CHECK (rating >= 1 AND rating <= 5)
  '''
}

Table review_ratings {
  rating_id int [pk, increment]
  review_id int [not null]
  category_id int [not null]
  rating_value int [not null]
  
  // PHASE 3 CONSTRAINTS
  indexes {
    review_id [name: "idx_review_ratings_review_id"]
    category_id [name: "idx_review_ratings_category_id"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_review_ratings_value CHECK (rating_value >= 1 AND rating_value <= 5)
  '''
}

// ==============================================
// COMMUNICATION DOMAIN (ENHANCED WITH CONSTRAINTS)
// ==============================================

Table conversations {
  conversation_id int [pk, increment]
  participant1_id int [not null]
  participant2_id int [not null]
  booking_id int [not null]
  created_at datetime [not null]
  last_message_at datetime
  
  // PHASE 3 CONSTRAINTS
  indexes {
    participant1_id [name: "idx_conversations_participant1_id"]
    participant2_id [name: "idx_conversations_participant2_id"]
    booking_id [name: "idx_conversations_booking_id"]
  }
}

Table messages {
  message_id int [pk, increment]
  conversation_id int [not null]
  sender_id int [not null]
  message_text text [not null]
  message_type varchar(20) [default: 'text']
  sent_at datetime [not null]
  read_at datetime
  
  // PHASE 3 CONSTRAINTS
  indexes {
    conversation_id [name: "idx_messages_conversation_id"]
    sender_id [name: "idx_messages_sender_id"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_messages_type CHECK (message_type IN ('text', 'image', 'file', 'system'))
  '''
}

// ==============================================
// SYSTEM DOMAIN (ENHANCED WITH CONSTRAINTS)
// ==============================================

Table notifications {
  notification_id int [pk, increment]
  user_id int [not null]
  notification_type varchar(50) [not null]
  title varchar(200) [not null]
  message text [not null]
  is_read boolean [default: false]
  created_at datetime [not null]
  sent_at datetime
  
  // PHASE 3 CONSTRAINTS
  indexes {
    user_id [name: "idx_notifications_user_id"]
    notification_type [name: "idx_notifications_type"]
    is_read [name: "idx_notifications_read"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_notifications_type CHECK (notification_type IN ('booking_confirmed', 'booking_cancelled', 'payment_received', 'review_received', 'message_received', 'system_alert'))
  '''
}

// ==============================================
// TRUE TRIPLE RELATIONSHIP JUNCTION TABLES (3 Required)
// ==============================================

// Triple Relationship 1: Property-Booking-Pricing
Table property_booking_pricing {
  pbp_id int [pk, increment]
  property_id int [not null]
  booking_id int [not null]
  pricing_id int [not null]
  applied_price decimal(10,2) [not null]
  pricing_rule_applied varchar(100)
  created_at datetime [not null]
  
  // PHASE 3 CONSTRAINTS
  indexes {
    property_id [name: "idx_pbp_property_id"]
    booking_id [name: "idx_pbp_booking_id"]
    pricing_id [name: "idx_pbp_pricing_id"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_pbp_applied_price CHECK (applied_price > 0)
  '''
}

// Triple Relationship 2: User-Booking-Review
Table user_booking_review {
  ubr_id int [pk, increment]
  user_id int [not null]
  booking_id int [not null]
  review_id int [not null]
  review_role varchar(20) [not null] // 'reviewer' or 'reviewee'
  interaction_type varchar(50) // 'written', 'received', 'responded'
  created_at datetime [not null]
  
  // PHASE 3 CONSTRAINTS
  indexes {
    user_id [name: "idx_ubr_user_id"]
    booking_id [name: "idx_ubr_booking_id"]
    review_id [name: "idx_ubr_review_id"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_ubr_review_role CHECK (review_role IN ('reviewer', 'reviewee'))
  CONSTRAINT chk_ubr_interaction_type CHECK (interaction_type IN ('written', 'received', 'responded'))
  '''
}

// Triple Relationship 3: Booking-Payment-Payout
Table booking_payment_payout {
  bpp_id int [pk, increment]
  booking_id int [not null]
  payment_id int [not null]
  payout_id int
  transaction_chain_status varchar(20) [not null] // 'pending', 'completed', 'failed'
  processing_notes text
  created_at datetime [not null]
  
  // PHASE 3 CONSTRAINTS
  indexes {
    booking_id [name: "idx_bpp_booking_id"]
    payment_id [name: "idx_bpp_payment_id"]
    payout_id [name: "idx_bpp_payout_id"]
  }
  
  // Business Rules
  note: '''
  CONSTRAINT chk_bpp_transaction_status CHECK (transaction_chain_status IN ('pending', 'completed', 'failed'))
  '''
}

// ==============================================
// UPDATED RELATIONSHIPS WITH CARDINALITY NOTATIONS
// ==============================================

// One-to-One Relationships (1:1) - ENHANCED
Ref: guest_profiles.user_id - users.user_id
Ref: host_profiles.user_id - users.user_id
Ref: user_profiles.user_id - users.user_id

// One-to-Many Relationships (1:N) - ENHANCED WITH CASCADE RULES
Ref: users.user_id > user_verification.user_id
Ref: users.user_id > user_preferences.user_id
Ref: users.user_id > payment_methods.user_id
Ref: users.user_id > reviews.reviewer_id
Ref: users.user_id > reviews.reviewee_id
Ref: users.user_id > conversations.participant1_id
Ref: users.user_id > conversations.participant2_id
Ref: users.user_id > messages.sender_id
Ref: users.user_id > notifications.user_id

// UPDATED: Properties now reference host_profiles with CASCADE
Ref: host_profiles.host_profile_id > properties.host_id

// UPDATED: Bookings now reference guest_profiles with RESTRICT
Ref: guest_profiles.guest_profile_id > bookings.guest_profile_id
Ref: users.user_id > bookings.user_id // For audit trail

// UPDATED: Payouts now reference host_profiles
Ref: host_profiles.host_profile_id > payouts.host_profile_id

Ref: property_types.property_type_id > properties.property_type_id
Ref: properties.property_id > property_amenity_links.property_id
Ref: properties.property_id > property_photos.property_id
Ref: properties.property_id > property_pricing.property_id
Ref: properties.property_id > bookings.property_id

Ref: addresses.address_id > properties.address_id
Ref: cities.city_id > addresses.city_id
Ref: countries.country_id > addresses.country_id
Ref: countries.country_id > cities.country_id

Ref: booking_status.status_id > bookings.booking_status_id
Ref: bookings.booking_id > booking_modifications.booking_id
Ref: bookings.booking_id > payments.booking_id
Ref: bookings.booking_id > reviews.booking_id
